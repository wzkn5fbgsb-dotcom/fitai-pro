# Copia este archivo como .env (NUNCA subas .env a GitHub).
# Las variables EXPO_PUBLIC_* se incrustan en la app: son públicas por diseño.
# Nunca pongas aquí claves secretas (service_role, Anthropic, etc.).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys (claves PÚBLICAS de cada plataforma)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Identificador de la app en las tiendas (opcional; por defecto com.fitaipro.app)
APP_BUNDLE_ID=com.fitaipro.app

# expo.dev → proyecto → Project ID (se rellena tras el primer `eas init` / build)
EAS_PROJECT_ID=
