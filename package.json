{
  "name": "fitai-pro",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "phone": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/core/__tests__/*.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "seed": "node --experimental-strip-types --no-warnings scripts/gen-seed.ts",
    "sync:functions": "node --experimental-strip-types --no-warnings scripts/sync-functions.ts",
    "verify:usda": "node --experimental-strip-types --no-warnings scripts/verify-usda.ts",
    "doctor": "npx expo-doctor@latest",
    "export:check": "expo export --platform ios --platform android --output-dir dist-check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-localization": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "^9.6.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
