# Secretos de las funciones del servidor (Supabase Edge Functions).
# NO se usan en la app. Se cargan con `supabase secrets set` o con el
# workflow "Supabase deploy" desde los Secrets de GitHub.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los pone Supabase automáticamente.

# Clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo de IA del coach
AI_MODEL=claude-haiku-5-5

# Precio del modelo en USD por millón de tokens (entrada / salida).
# Cópialos de la página de precios ACTUAL del proveedor: se usan para estimar
# el gasto y cortar el coach cuando se alcanza el presupuesto mensual (plan_config).
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=

# Secreto que RevenueCat enviará en la cabecera Authorization del webhook
# (en RevenueCat se escribe como: Bearer <este valor>). Usa una cadena larga y aleatoria.
REVENUECAT_WEBHOOK_AUTH=
